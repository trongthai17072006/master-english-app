# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CLOUD SYNC & AUTH (Phase 3):
# If left empty, MASTER English runs 100% in Local Mode using localStorage as before.
# IMPORTANT SECURITY RULE: ONLY use the public "anon" / "publishable" key here.
# NEVER put the Supabase "service_role" secret key in frontend / VITE_ variables!
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ============================================================================
# RBAC ADMIN SECURITY — CONTENT IMPORTER (+ NẠP / MỞ RỘNG DỮ LIỆU HỌC)
# Chỉ tài khoản khớp với VITE_ADMIN_EMAIL và nhập đúng VITE_ADMIN_SECRET_KEY
# mới nhìn thấy giao diện và có quyền ghi/nạp thêm Từ vựng, Cấu trúc #78+, Lộ trình.
# ============================================================================
VITE_ADMIN_EMAIL="trongthai17072006@gmail.com"
VITE_ADMIN_SECRET_KEY="your_secret_admin_password_here"

# ============================================================================
# ELEVENLABS GLOBAL TEXT-TO-SPEECH (BACKEND ONLY — DO NOT EXPOSE TO FRONTEND)
# Unified Voice ID across the entire MASTER ENGLISH platform: NaMUH1vcebhHvD4z3Lku
# ============================================================================
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY"
ELEVENLABS_VOICE_ID="NaMUH1vcebhHvD4z3Lku"

# ============================================================================
# GOOGLE OAUTH 2.0 CREDENTIALS (BACKEND / SUPABASE AUTH PROVIDER ONLY)
# IMPORTANT: NEVER prefix GOOGLE_OAUTH_CLIENT_SECRET with VITE_!
# Keep Client Secret strictly in .env (gitignored), Cloud Run Secrets, or Supabase Auth Dashboard.
# ============================================================================
GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_OAUTH_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"

